{
  "schema_version": 1,
  "components": ["frontend", "backend", "worker", "infrastructure"],
  "fallback_components": ["frontend", "backend", "worker", "infrastructure"],
  "rules": [
    {"id": "release-tooling", "patterns": ["scripts/release/**", ".github/workflows/**", "infra/**", "docker-compose*.yml", ".dockerignore"], "components": ["frontend", "backend", "worker", "infrastructure"]},
    {"id": "verification-tooling", "patterns": ["scripts/testing/**", "scripts/performance/**", "tests/suites.json"], "components": ["infrastructure"]},
    {"id": "animation-catalog", "patterns": ["backend/animationpresentation/catalog.json"], "components": ["frontend", "backend", "worker"]},
    {"id": "audio-catalog", "patterns": ["backend/audiopresentation/catalog.json"], "components": ["frontend", "backend"]},
    {"id": "backend", "patterns": ["backend/**"], "components": ["backend"]},
    {"id": "worker-shell", "patterns": ["frontend/worker/**"], "components": ["worker"]},
    {"id": "frontend-dependencies", "patterns": ["frontend/package*.json", "frontend/.npmrc", "frontend/tsconfig*.json"], "components": ["frontend", "worker"]},
    {"id": "frontend-build", "patterns": ["frontend/Dockerfile", "frontend/Dockerfile.dockerignore", "frontend/.dockerignore", "frontend/vite.config.*", "frontend/index.html", "frontend/start.sh", "frontend/write-build-info.sh", "frontend/nginx.conf.template", "frontend/scripts/**", "frontend/public/**"], "components": ["frontend"]},
    {"id": "frontend-ui", "patterns": ["frontend/src/components/**", "frontend/src/pages/**", "frontend/src/contexts/**", "frontend/src/hooks/**", "frontend/src/api/**", "frontend/src/assets/**", "frontend/src/styles/**", "frontend/src/*.tsx", "frontend/src/**/*.css", "frontend/src/**/*.scss"], "components": ["frontend"]},
    {"id": "shared-runtime", "patterns": ["frontend/src/**", "frontend/utils/**", "frontend/charges/**"], "components": ["frontend", "worker"]},
    {"id": "frontend-tests", "patterns": ["frontend/e2e/**", "frontend/e2e-live/**", "frontend/test-fixtures/**", "frontend/playwright*.ts", "frontend/vitest*.ts", "frontend/eslint*", "frontend/.eslintrc*"], "components": ["frontend", "worker"]},
    {"id": "frontend-docs", "patterns": ["frontend/README.md"], "components": []},
    {"id": "documentation", "patterns": ["docs/**", "README.md", "CHANGELOG.md", "AGENTS.md", "LICENSE", "LICENSE.*", ".agents/**"], "components": []},
    {"id": "local-results", "patterns": ["output/**", "outputs/**", "tmp/**", "backups/**", ".local-postgres/**"], "components": []}
  ],
  "notes": [
    "Rules use first match. Unknown inputs conservatively select every component.",
    "The worker build validates its actual esbuild source graph against these rules; an unexpected UI/backend dependency must be declared explicitly.",
    "Generated worker input evidence can only add worker checks; stale evidence can never exclude a component.",
    "Documentation under frontend/src is a production raw import and belongs to shared-runtime, not documentation."
  ]
}
