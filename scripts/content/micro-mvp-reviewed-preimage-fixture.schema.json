{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dnd-cards/micro-mvp-reviewed-preimage-fixture.schema.json",
  "title": "MicroMvpReviewedPreimageFixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "sourceSnapshot",
    "patch",
    "selection",
    "catalogs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fixtureId": {
      "const": "dnd5e-2024.micro-mvp-l1.reviewed-source-preimage.v1"
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "directory"],
      "properties": {
        "releaseId": { "type": "string", "minLength": 1 },
        "directory": { "const": "officials/canon/prod-snapshot" }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sourceReleaseId", "canonicalHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sourceReleaseId": { "type": "string", "minLength": 1 },
        "canonicalHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "counts", "total"],
      "properties": {
        "strategy": {
          "const": "patch-targets-plus-declared-entity-references"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effects", "actions", "spells", "races", "classes", "cards"],
          "properties": {
            "effects": { "type": "integer", "minimum": 0 },
            "actions": { "type": "integer", "minimum": 0 },
            "spells": { "type": "integer", "minimum": 0 },
            "races": { "type": "integer", "minimum": 0 },
            "classes": { "type": "integer", "minimum": 0 },
            "cards": { "type": "integer", "minimum": 0 }
          }
        },
        "total": { "type": "integer", "minimum": 1 }
      }
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effects", "actions", "spells", "races", "classes", "cards"],
      "properties": {
        "effects": { "$ref": "#/definitions/catalog" },
        "actions": { "$ref": "#/definitions/catalog" },
        "spells": { "$ref": "#/definitions/catalog" },
        "races": { "$ref": "#/definitions/catalog" },
        "classes": { "$ref": "#/definitions/catalog" },
        "cards": { "$ref": "#/definitions/catalog" }
      }
    }
  },
  "definitions": {
    "catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "card_number"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "card_number": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  }
}
