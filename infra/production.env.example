# Public hostname handled by Caddy. For a shadow deployment an sslip.io name
# may be used; production uses bagofholding.ru.
APP_DOMAIN=203-0-113-10.sslip.io

# Immutable release identity and local Docker image tag.
SOURCE_COMMIT=0000000000000000000000000000000000000000

# Optional override. The default is outside each release so secrets survive
# atomic release-directory swaps and never enter Docker images.
APP_ENV_FILE=/opt/bagofholding/shared/app.env
