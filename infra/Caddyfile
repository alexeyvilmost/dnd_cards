{$APP_DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	handle /_edge-health {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy frontend:3000 {
			header_up X-Real-IP {remote_host}
		}
	}
}
