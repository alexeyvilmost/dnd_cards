{
  "name": "dnd-cards-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc && vite build --config vite.config.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --config vite.config.ts",
    "rules-lab:generate": "node scripts/generate-rules-lab-fixture.mjs",
    "rules-lab:check": "node scripts/generate-rules-lab-fixture.mjs --check",
    "sheet-combat-certification:generate": "node scripts/generate-sheet-combat-certification.mjs",
    "sheet-combat-certification:check": "node scripts/generate-sheet-combat-certification.mjs --check",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "test:browser:live": "playwright test --config playwright.live.config.ts",
    "test:browser:live:sheet": "playwright test --config playwright.live.config.ts --grep \"public sheet certificate:\"",
    "test:browser:live:typecheck": "tsc -p tsconfig.live.json --noEmit",
    "test:browser:headed": "npm run build && playwright test --headed",
    "test:e2e:micro": "npm run test:browser",
    "test:mvp": "vitest run --config vitest.mvp.config.ts",
    "test:rules:contracts": "vitest run src/rules-core/coverage src/rules-core/importBoundary.test.ts",
    "test:rules:scenarios": "vitest run src/rules-core/testing/microMvpScenarioCorpus.test.ts src/rules-core/testing/scenario.test.ts",
    "test:rules:replay": "vitest run src/rules-core/determinism.test.ts src/rules-core/worldMigration.test.ts src/rules-core/world.test.ts",
    "test:rules:coverage": "vitest run --config vitest.rules-core.config.ts",
    "test:rules:primitives": "vitest run --config vitest.rules-primitives.config.ts --coverage",
    "test:micro:manifest": "node --test ../scripts/content/micro-mvp-manifest.test.mjs ../scripts/content/micro-micro-manifest.test.mjs ../scripts/content/api.pagination.test.mjs ../scripts/content/export-prod.test.mjs ../scripts/content/migrate-micro-mvp-l1-mechanics.test.mjs ../scripts/content/micro-mvp-certifications.test.mjs ../scripts/content/micro-mvp-release-evidence.test.mjs ../scripts/content/basic-actions-certifications.test.mjs",
    "test:mini:catalog": "node --test ../scripts/content/mini-mvp-manifest.test.mjs ../scripts/content/mini-mvp-audit.test.mjs ../scripts/content/upgrade-mini-mvp-cantrip-primitives.test.mjs ../scripts/content/upgrade-mini-mvp-level1-riders.test.mjs ../scripts/content/upgrade-mini-mvp-ongoing-spells.test.mjs ../scripts/content/upgrade-mini-mvp-traversal-spells.test.mjs ../scripts/content/upgrade-mini-mvp-control-spells.test.mjs ../scripts/content/upgrade-mini-mvp-utility-cantrips.test.mjs ../scripts/content/upgrade-mini-mvp-utility-level1-spells.test.mjs ../scripts/content/mark-mini-mvp-reviewed-spells.test.mjs",
    "test:micro:live": "node ../scripts/content/micro-micro-gate.mjs --strict",
    "test:micro:matrix": "vitest run --config vitest.matrix.config.ts",
    "test:micro:live-matrix": "vitest run --config vitest.live-matrix.config.ts",
    "test:micro:certification": "vitest run --config vitest.live-matrix.config.ts src/mvp/micro-micro.certification.live.test.ts",
    "test:mini:live-ongoing": "vitest run --config vitest.live-matrix.config.ts src/mvp/mini-mvp.ongoing-spells.live.test.ts",
    "test:mini:live-traversal": "vitest run --config vitest.live-matrix.config.ts src/mvp/mini-mvp.traversal-spells.live.test.ts",
    "test:mini:live-control": "vitest run --config vitest.live-matrix.config.ts src/mvp/mini-mvp.control-spells.live.test.ts",
    "test:mini:live-utility": "vitest run --config vitest.live-matrix.config.ts src/mvp/mini-mvp.utility-cantrips.live.test.ts",
    "test:mini:live-utility-level1": "vitest run --config vitest.live-matrix.config.ts src/mvp/mini-mvp.utility-level1-spells.live.test.ts",
    "test:micro:coverage": "node scripts/run-micro-mvp-coverage.mjs",
    "test:content-manifest": "npm run test:micro:manifest",
    "test:micro-micro:live": "npm run test:micro:live",
    "test:micro-micro:matrix": "npm run test:micro:matrix",
    "test:micro-micro:certification": "npm run test:micro:certification",
    "content:certify": "node ../scripts/content/certify-content.mjs",
    "content:certify:micro": "node ../scripts/content/micro-mvp-certifications.mjs",
    "content:audit:mini": "node ../scripts/content/mini-mvp-audit.mjs --strict",
    "content:upgrade:mini-cantrips": "node ../scripts/content/upgrade-mini-mvp-cantrip-primitives.mjs",
    "content:upgrade:mini-riders": "node ../scripts/content/upgrade-mini-mvp-level1-riders.mjs",
    "content:upgrade:mini-ongoing": "node ../scripts/content/upgrade-mini-mvp-ongoing-spells.mjs",
    "content:upgrade:mini-traversal": "node ../scripts/content/upgrade-mini-mvp-traversal-spells.mjs",
    "content:upgrade:mini-control": "node ../scripts/content/upgrade-mini-mvp-control-spells.mjs",
    "content:upgrade:mini-utility": "node ../scripts/content/upgrade-mini-mvp-utility-cantrips.mjs",
    "content:evidence:micro": "node ../scripts/content/generate-micro-mvp-release-evidence.mjs"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@fontsource/pangolin": "^5.2.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.6.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.294.0",
    "mermaid": "^11.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
