# SPA: статика + fallback на index.html. ${PORT} подставляется в start.sh
server {
    listen 0.0.0.0:${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    access_log /dev/stdout;
    error_log /dev/stderr warn;

    location /health {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location = /build-info.json {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /assets/ {
        try_files $uri @retained_asset;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Long-lived tabs may still import a content-hashed chunk from an older
    # release. Only immutable asset routes can reach the retained directory.
    location ~ ^/workbox-[a-f0-9]+\.js$ {
        try_files $uri @retained_asset;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location @retained_asset {
        root /var/lib/bagofholding/frontend;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # PWA bootstrap-файлы должны перепроверяться при каждом запуске, иначе CDN
    # или браузер могут надолго оставить пользователя на старой версии приложения.
    location = /sw.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /registerSW.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /manifest.webmanifest {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri /index.html;
    }
}
