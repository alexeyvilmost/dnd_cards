# This Dockerfile builds from the repository root. Only the frontend and the
# shared animation catalog are needed; keep local outputs and credentials out.
*
!frontend
!frontend/**
!backend
!backend/animationpresentation
!backend/animationpresentation/catalog.json

frontend/node_modules
frontend/dist
frontend/.env
frontend/.env.*
frontend/README.md
frontend/tsconfig.tsbuildinfo
frontend/tsconfig.node.tsbuildinfo
frontend/vite.config.d.ts
frontend/vite.config.js
frontend/src/**/*.test.ts
frontend/src/**/*.test.tsx
frontend/src/testing/featAuditFixtures.ts
frontend/e2e
frontend/e2e-live
frontend/.micro-mvp-evidence
frontend/coverage
frontend/test-results
frontend/playwright-report
frontend/blob-report
